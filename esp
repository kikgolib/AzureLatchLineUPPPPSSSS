		colorBtn.TextSize = 10
		colorBtn.Parent = card
		Instance.new("UICorner", colorBtn).CornerRadius = UDim.new(0, 4)

		colorBtn.MouseButton1Click:Connect(function()
			local cIdx = 1
			for i, c in ipairs(availableColors) do
				if c == data.color then
					cIdx = (i % #availableColors) + 1
					break
				end
			end
			data.color = availableColors[cIdx]
			colorBtn.BackgroundColor3 = data.color
			createESP(plr)
		end)

		local cModeBtn = Instance.new("TextButton")
		cModeBtn.Size = UDim2.new(0, 110, 0, 22)
		cModeBtn.Position = UDim2.new(0, 96, 0, 32)
		cModeBtn.BackgroundColor3 = Color3.fromRGB(15, 16, 20)
		cModeBtn.TextColor3 = Color3.fromRGB(88, 101, 242)
		cModeBtn.Text = data.mode
		cModeBtn.Font = Enum.Font.Gotham
		cModeBtn.TextSize = 10
		cModeBtn.Parent = card
		Instance.new("UICorner", cModeBtn).CornerRadius = UDim.new(0, 4)

		cModeBtn.MouseButton1Click:Connect(function()
			local mIdx = 1
			for i, m in ipairs(modeOrder) do
				if m == data.mode then
					mIdx = (i % #modeOrder) + 1
					break
				end
			end
			data.mode = modeOrder[mIdx]
			cModeBtn.Text = data.mode
			createESP(plr)
		end)
	end
end

-- Поиск игроков
local function findPlayers(searchText)
	local matches = {}
	searchText = string.lower(searchText)

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= localPlayer then
			if string.find(string.lower(plr.Name), searchText) or string.find(string.lower(plr.DisplayName), searchText) then
				table.insert(matches, plr)
			end
		end
	end
	return matches
end

-- Добавление
addPlayerBtn.MouseButton1Click:Connect(function()
	local text = nameInput.Text
	if text == "" then return end

	local targets = findPlayers(text)
	for _, targetPlr in ipairs(targets) do
		if not trackedPlayers[targetPlr] then
			local connList = {}
			trackedPlayers[targetPlr] = {
				color = Color3.fromRGB(88, 101, 242),
				mode = selectedMode,
				connections = connList
			}

			local charConn = targetPlr.CharacterAdded:Connect(function()
				task.wait(0.5)
				createESP(targetPlr)
			end)
			table.insert(connList, charConn)

			createESP(targetPlr)
		end
	end

	nameInput.Text = ""
	refreshListUI()
end)

-- Удаление при выходе
local remConn = Players.PlayerRemoving:Connect(function(plr)
	if trackedPlayers[plr] then
		clearPlayerVisuals(plr)
		trackedPlayers[plr] = nil
		refreshListUI()
	end
end)
table.insert(globalConnections, remConn)

-- Логика Функция Самоуничтожения
destroyBtn.MouseButton1Click:Connect(function()
	-- 1. Отключение всех глобальных событий
	for _, c in ipairs(globalConnections) do
		if c then c:Disconnect() end
	end
	globalConnections = {}

	-- 2. Очистка визуалов и приватных событий игроков
	for plr, data in pairs(trackedPlayers) do
		clearPlayerVisuals(plr)
		if data.connections then
			for _, c in pairs(data.connections) do
				if c then c:Disconnect() end
			end
		end
	end
	trackedPlayers = {}

	-- 3. Удаление UI
	if screenGui then
		screenGui:Destroy()
	end
end)
