-- Очистка визуалов игрока
local function clearPlayerVisuals(plr)
	if visualObjects[plr] then
		for _, v in pairs(visualObjects[plr]) do
			if typeof(v) == "RBXScriptConnection" then
				v:Disconnect()
			elseif v and v.Remove then
				v:Remove()
			elseif v and v.Destroy then
				v:Destroy()
			end
		end
		visualObjects[plr] = nil
	end
end

-- Логика отрисовки визуалов
local function createESP(plr)
	clearPlayerVisuals(plr)

	local data = trackedPlayers[plr]
	if not data then return end

	local char = plr.Character
	if not char then return end

	local objs = {}
	visualObjects[plr] = objs

	local mode = data.mode
	local color = data.color

	-- Highlight
	if mode == "Highlight" or mode == "Full ESP" then
		local hl = Instance.new("Highlight")
		hl.Adornee = char
		hl.FillColor = color
		hl.OutlineColor = Color3.fromRGB(255, 255, 255)
		hl.FillTransparency = 0.5
		hl.OutlineTransparency = 0
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.Parent = char
		table.insert(objs, hl)
	end

	-- Name ESP
	if mode == "Name ESP" or mode == "Full ESP" then
		local head = char:FindFirstChild("Head")
		if head then
			local bb = Instance.new("BillboardGui")
			bb.Adornee = head
			bb.Size = UDim2.new(0, 150, 0, 30)
			bb.StudsOffset = Vector3.new(0, 2, 0)
			bb.AlwaysOnTop = true
			bb.Parent = head

			local lbl = Instance.new("TextLabel")
			lbl.Size = UDim2.new(1, 0, 1, 0)
			lbl.BackgroundTransparency = 1
			lbl.TextColor3 = color
			lbl.TextStrokeTransparency = 0
			lbl.Font = Enum.Font.GothamBold
			lbl.TextSize = 12
			lbl.Text = plr.DisplayName .. " (@" .. plr.Name .. ")"
			lbl.Parent = bb
			table.insert(objs, bb)
		end
	end

	-- Box ESP
	if (mode == "Boxes" or mode == "Full ESP") and Drawing then
		local box = Drawing.new("Square")
		box.Visible = false
		box.Color = color
		box.Thickness = 1.5
		box.Filled = false

		local conn = RunService.RenderStepped:Connect(function()
			if plr and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
				local hrp = plr.Character.HumanoidRootPart
				local pos, onScreen = camera:WorldToViewportPoint(hrp.Position)

				if onScreen then
					local sizeY = (camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0)).Y - camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 3, 0)).Y)
					local sizeX = sizeY / 1.5

					box.Size = Vector2.new(sizeX, sizeY)
					box.Position = Vector2.new(pos.X - sizeX / 2, pos.Y - sizeY / 2)
					box.Color = trackedPlayers[plr].color
					box.Visible = true
				else
					box.Visible = false
				end
			else
				box.Visible = false
			end
		end)

		table.insert(objs, box)
		table.insert(objs, conn)
	end

	-- Skeleton ESP
	if (mode == "Skeleton" or mode == "Full ESP") and Drawing then
		local lines = {}
		local joints = {
			{"Head", "UpperTorso"},
			{"UpperTorso", "LowerTorso"},
			{"UpperTorso", "LeftUpperArm"},
			{"LeftUpperArm", "LeftLowerArm"},
			{"UpperTorso", "RightUpperArm"},
			{"RightUpperArm", "RightLowerArm"},
			{"LowerTorso", "LeftUpperLeg"},
			{"LeftUpperLeg", "LeftLowerLeg"},
			{"LowerTorso", "RightUpperLeg"},
			{"RightUpperLeg", "RightLowerLeg"}
		}

		for _ in ipairs(joints) do
			local l = Drawing.new("Line")
			l.Visible = false
			l.Thickness = 1.5
			l.Color = color
			table.insert(lines, l)
			table.insert(objs, l)
		end

		local conn = RunService.RenderStepped:Connect(function()
			if plr and plr.Character then
				for i, pair in ipairs(joints) do
					local p1 = plr.Character:FindFirstChild(pair[1])
					local p2 = plr.Character:FindFirstChild(pair[2])

					if p1 and p2 then
						local pos1, vis1 = camera:WorldToViewportPoint(p1.Position)
						local pos2, vis2 = camera:WorldToViewportPoint(p2.Position)

						if vis1 and vis2 then
							lines[i].From = Vector2.new(pos1.X, pos1.Y)
							lines[i].To = Vector2.new(pos2.X, pos2.Y)
							lines[i].Color = trackedPlayers[plr].color
							lines[i].Visible = true
						else
							lines[i].Visible = false
						end
					else
						lines[i].Visible = false
					end
				end
			end
		end)

		table.insert(objs, conn)
	end
end

